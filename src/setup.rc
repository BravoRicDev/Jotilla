#include <windows.h>
#include "resource.h"
IDI_APP ICON "assets/jotilla.ico"
IDR_APPLICATION RCDATA "dist/Jotilla.exe"
IDR_LICENSE RCDATA "LICENSE"
1 VERSIONINFO
 FILEVERSION APP_VERSION_NUM
 PRODUCTVERSION APP_VERSION_NUM
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "FileDescription", "Jotilla Setup\0"
   VALUE "FileVersion", APP_VERSION "\0"
   VALUE "ProductName", "Jotilla\0"
   VALUE "ProductVersion", APP_VERSION "\0"
   VALUE "LegalCopyright", "MIT - Alessio Garau\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
